{
  "manifest_version": 3,
  "name": "Webby Chat",
  "version": "1.0.0",
  "description": "Your webpage AI assistant",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://new-repo.fastapicloud.dev/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Webby Chat"
  }
}
