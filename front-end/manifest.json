{
  "manifest_version": 3,
  "name": "PagePal",
  "version": "1.0",
  "description": "Your webpage AI assistant",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PagePal"
  }
}